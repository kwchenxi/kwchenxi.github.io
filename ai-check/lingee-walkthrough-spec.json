  "walkthrough_dimensions": {
    "L1_responsive": {
      "level": 1,
      "name": "响应式布局",
      "description": "截断、溢出、列数不降、最小/最大窗口",
      "check_items": [
        "窗口最小尺寸下布局是否正常",
        "窗口最大尺寸下是否有过度拉伸",
        "卡片/列表列数是否随宽度调整",
        "文本截断是否合理（有省略号、不异常换行）",
        "筛选栏/导航栏是否自适应"
      ]
    },
    "L1_spec_compliance": {
      "level": 1,
      "name": "设计规范对照",
      "description": "组件尺寸、间距、字号、圆角、颜色值",
      "check_items": [
        "按钮高度是否匹配 sm=24/md=28/std=32/lg=36",
        "弹窗宽度是否为 460/640/720 之一",
        "间距是否基于 4px 网格",
        "圆角是否匹配 Token（medium=6, x-medium=8, large=12...）",
        "字号/字重是否匹配 Typography 规范"
      ]
    },
    "L2_edge_cases": {
      "level": 2,
      "name": "极限边界",
      "description": "超长文本、超大数字、特殊字符、0条数据",
      "check_items": [
        "标题/名称超过 20 字时截断表现",
        "数字字段超过 6 位时显示",
        "特殊字符（emoji、CJK 扩展）渲染",
        "列表 0 条时的空状态",
        "单条数据时的布局"
      ]
    },
    "L2_dark_mode": {
      "level": 2,
      "name": "暗黑模式适配",
      "description": "切换后未适配的元素、颜色对比度不足",
      "check_items": [
        "背景是否正确切换为深色",
        "文字颜色是否有对应浅色",
        "是否有硬编码颜色未跟随主题",
        "图片/图标在深色背景上可见性",
        "阴影是否适配（深色下通常不需要或更弱）"
      ]
    },
    "L2_states": {
      "level": 2,
      "name": "空状态与错误状态",
      "description": "空列表、空搜索、无网络、无权限",
      "check_items": [
        "列表空状态是否有引导操作",
        "搜索无结果是否有提示",
        "网络断开时的错误提示",
        "加载中状态是否有明确反馈",
        "权限不足时的提示"
      ]
    },
    "L2_focus_keyboard": {
      "level": 2,
      "name": "焦点与键盘导航",
      "description": "Tab 顺序、focus ring 可见性、快捷键",
      "check_items": [
        "输入框聚焦时是否有主色描边（#495DFF）",
        "按钮聚焦时是否有可见 focus ring",
        "Tab 键导航顺序是否合理",
        "Enter 键是否触发主操作",
        "Esc 键是否关闭弹窗/下拉"
      ]
    },
    "L3_i18n": {
      "level": 3,
      "name": "国际化",
      "description": "切换语言后文本截断、布局错乱、RTL 适配",
      "check_items": [
        "英文文本比中文长时布局是否溢出",
        "日文/韩文渲染是否正常",
        "RTL 语言（阿拉伯语）布局是否镜像",
        "日期/数字格式是否本地化",
        "字体 fallback 是否正确"
      ]
    },
    "L3_a11y": {
      "level": 3,
      "name": "无障碍 (a11y)",
      "description": "ARIA 标签、对比度、可访问性树完整性",
      "check_items": [
        "图标按钮是否有 aria-label",
        "文字/背景对比度是否 ≥ 4.5:1（正文）/ 3:1（大字）",
        "placeholder 文本是否完整（不被拆分为单字）",
        "弹窗是否有 focus trap 和 Esc 关闭",
        "图片是否有 alt 文本"
      ]
    },
    "L3_token_binding": {
      "level": 3,
      "name": "Token 绑定正确性",
      "description": "颜色、间距是否使用了正确的 CSS 变量而非硬编码",
      "check_items": [
        "主色元素是否使用 --lg-* 变量",
        "文字颜色是否使用语义色板 Token",
        "间距是否使用 spacing Token 而非硬编码 px",
        "圆角是否使用 radius Token",
        "阴影是否使用 shadow Token"
      ]
    },
    "L3_variant_completeness": {
      "level": 3,
      "name": "Variant 完整性",
      "description": "Figma 定义的 variant 是否全部实现",
      "check_items": [
        "组件的所有 size 变体是否都可用",
        "所有 state（default/hover/focus/pressed/disabled）是否有对应样式",
        "所有 type/variant 是否都有实现",
        "danger/ghost 等布尔变体是否生效",
        "shape 变体（default/round）是否正确"
      ]
    },
    "L3_consistency": {
      "level": 3,
      "name": "跨页面一致性",
      "description": "同类组件在不同页面的表现是否统一",
      "check_items": [
        "同类型按钮在不同页面高度是否一致",
        "输入框聚焦态在所有页面是否都有描边",
        "间距/留白在同类页面是否统一",
        "同类卡片/列表样式是否一致",
        "导航/操作反馈是否全局统一"
      ]
    }
  },

  "scoring": {
    "severity": {
      "critical": { "weight": 10, "label": "严重", "description": "功能不可用或严重影响使用" },
      "major": { "weight": 5, "label": "中等", "description": "影响体验但有 workaround" },
      "minor": { "weight": 2, "label": "轻微", "description": "不影响功能但影响品质感" },
      "info": { "weight": 0, "label": "建议", "description": "优化建议，非问题" }
    },
    "dimension_score": {
      "description": "每个维度满分 100，按发现问题数 × 权重扣分",
      "formula": "score = max(0, 100 - sum(severity_weight × count))",
      "grade": {
        "A": { "min": 90, "label": "优秀" },
        "B": { "min": 75, "label": "良好" },
        "C": { "min": 60, "label": "合格" },
        "D": { "min": 40, "label": "待改进" },
        "F": { "min": 0, "label": "不合格" }
      }
    },
    "overall_score": {
      "description": "所有维度加权平均",
      "L1_weight": 0.4,
      "L2_weight": 0.35,
      "L3_weight": 0.25
    }
  }
